{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      "@kinoshelf/core": ["./packages/core/src/index.ts"],
      "@kinoshelf/provider-tmdb": ["./packages/providers/tmdb/src/index.ts"],
      "@kinoshelf/cli": ["./packages/cli/src/cli.ts"],
      "@kinoshelf/i18n": ["./packages/i18n/src/index.ts"]
    }
  },
  "include": [
    "*.ts",
    "packages/*/src",
    "packages/*/test",
    "packages/*/*.ts",
    "packages/providers/*/src",
    "packages/providers/*/test",
    "packages/providers/*/*.ts"
  ],
  "exclude": ["packages/web"]
}
